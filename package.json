{
  "name": "smart-file-rename",
  "version": "1.0.0",
  "description": "智能文件重命名工具 - 基于AI和OCR的跨平台桌面应用",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "icexcellent",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env IS_DEV=true electron .",
    "build": "tsc && vite build",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "electron:build": "npm run build:renderer && npm run build:main && electron-builder",
    "electron:build:win": "npm run build:renderer && npm run build:main && electron-builder --win",
    "build:ci": "npm run build:renderer && npm run build:main && electron-builder --publish=never",
    "build:ci:win": "npm run build:renderer && npm run build:main && electron-builder --win --publish=never",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^5.12.8",
    "axios": "^1.6.2",
    "electron-store": "^8.1.0",
    "file-type": "^18.7.0",
    "fs-extra": "^11.2.0",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.1",
    "tesseract.js": "^5.0.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.icexcellent.smart-file-rename",
    "productName": "智能文件重命名工具",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/tesseract.js-core",
        "to": "tesseract-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "智能文件重命名工具-${version}-portable.exe",
      "requestedExecutionLevel": "asInvoker",
      "env": {
        "TESSERACT_CORE_PATH": "./tesseract-core"
      }
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "智能文件重命名工具-${version}-linux.AppImage"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
